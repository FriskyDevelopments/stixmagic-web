NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
BOT_PORT=4100
STICKER_ENGINE_PORT=4200
TRIGGER_ENGINE_PORT=4300
POSTGRES_URL=postgres://stixmagic:stixmagic@localhost:5432/stixmagic
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sticker-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Shared STIX MΛGIC Telegram surface configuration.
STIXMAGIC_PUBLIC_WEB_URL=http://localhost:3000
STIXMAGIC_API_BASE_URL=http://localhost:4000
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=StixMagicBot
TELEGRAM_MINI_APP_URL=http://localhost:3000/dashboard
TELEGRAM_BOT_MODE=polling
# TELEGRAM_WEBHOOK_URL=https://api.example.com/telegram/webhook
# Required for production webhook validation. Use the same value when calling
# Telegram setWebhook with secret_token.
TELEGRAM_WEBHOOK_SECRET=replace_me
# Executes queued sticker/reaction work in the API process for the MVP.
ENABLE_JOB_WORKER=true

# Web build-time Telegram Mini App configuration.
NEXT_PUBLIC_STIXMAGIC_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_STIXMAGIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_STIXMAGIC_BOT_USERNAME=StixMagicBot
NEXT_PUBLIC_STIXMAGIC_MINI_APP_URL=http://localhost:3000/dashboard
NEXT_PUBLIC_STIXMAGIC_MANIFEST_URL=
NEXT_PUBLIC_STIXMAGIC_USE_DEMO_DATA=false
# Optional: allow web app to fall back to mock data if live API requests fail.
# Keep false in production to avoid masking API/auth issues.
NEXT_PUBLIC_STIXMAGIC_ALLOW_API_FALLBACK=false

# ── Cloudflare Pages deployment ──────────────────────────────────────────────
# Production:  https://stixmagic.com
# Dev/Preview: https://preview.stixmagic.com
#
# Required GitHub secrets (Settings → Secrets → Actions):
#   CLOUDFLARE_API_TOKEN   – Cloudflare API token with "Cloudflare Pages:Edit" permission
#   CLOUDFLARE_ACCOUNT_ID  – Your Cloudflare account ID (Cloudflare dashboard sidebar)
#
# Required GitHub repository variable (Settings → Variables → Actions):
#   CF_PAGES_PROJECT_NAME  – Cloudflare Pages project name (default: stixmagic-web)
#
# Optional per-environment overrides – if not set, the defaults below are used:
#   STIXMAGIC_API_BASE_URL          – API base URL (production, default: https://stixmagic.com)
#   STIXMAGIC_PUBLIC_WEB_URL        – Public web URL (production, default: https://stixmagic.com)
#   STIXMAGIC_MINI_APP_URL          – Mini app URL (production, default: https://stixmagic.com/dashboard)
#   STIXMAGIC_MANIFEST_URL          – Pipeline manifest URL (production)
#   STIXMAGIC_ALLOW_API_FALLBACK    – Allow web to use mock fallback if API fails (prod default: false)
#   STIXMAGIC_API_BASE_URL_DEV      – API base URL (dev, default: https://preview.stixmagic.com)
#   STIXMAGIC_PUBLIC_WEB_URL_DEV    – Public web URL (dev, default: https://preview.stixmagic.com)
#   STIXMAGIC_MINI_APP_URL_DEV      – Mini app URL (dev, default: https://preview.stixmagic.com/dashboard)
#   STIXMAGIC_MANIFEST_URL_DEV      – Pipeline manifest URL (dev/preview)
#   STIXMAGIC_ALLOW_API_FALLBACK_DEV – Allow web to use mock fallback in dev/preview (default: true)
#   STIXMAGIC_BOT_USERNAME          – Telegram bot username

# ── LORE MVP0 ─────────────────────────────────────────────────────────────────
# Optional web build-time API base URL. In production, set this to the HTTPS
# origin that serves services/api; if omitted, the static site stays local-only
# instead of attempting to call localhost from a visitor's browser.
# NEXT_PUBLIC_LORE_API_BASE_URL=https://api.example.com
# MyFenrir should issue signed invite tokens with this server-only secret.
LORE_MEMBER_INVITE_SECRET=replace_me
LORE_PUBLIC_URL=http://localhost:3000
LORE_DEFAULT_TENANT_ID=myfenrir-internal
# Development-only fallback. Keep false in production.
LORE_ALLOW_DEV_IDENTITY=false
# Optional: server-only private community destination; never add it to NEXT_PUBLIC_*.
# LORE_PRIVATE_COMMUNITY_URL=https://t.me/+replace_me
# Optional transactional email webhook; the API sends only signed LORE links and template metadata.
# LORE_EMAIL_WEBHOOK_URL=https://email.example.com/lore
# Set true only for an internal admin preview of an invitation link.
LORE_ALLOW_ADMIN_INVITE_PREVIEW=false

# ── Nango MVP0 / Google Calendar ──────────────────────────────────────────────
# All three values are server-only. Nango stores provider credentials and refresh tokens.
# NANGO_API_KEY=replace_me
# NANGO_WEBHOOK_SIGNING_KEY=replace_me
# NANGO_GOOGLE_CALENDAR_INTEGRATION_ID=google-calendar
# Optional self-hosted Nango URL; leave unset for Nango Cloud.
# NANGO_HOST=https://api.nango.dev
